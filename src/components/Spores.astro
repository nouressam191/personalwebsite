---
// Softly drifting spores. Decorative; positions are seeded so builds are stable.
interface Props {
  count?: number;
  seed?: number;
  class?: string;
}
const { count = 18, seed = 3, class: className } = Astro.props;

let a = seed;
const rand = () => {
  a = (a * 16807) % 2147483647;
  return (a - 1) / 2147483646;
};
const spores = Array.from({ length: count }, () => ({
  left: (rand() * 100).toFixed(1),
  bottom: (rand() * 60).toFixed(1),
  size: (3 + rand() * 5).toFixed(1),
  duration: (9 + rand() * 9).toFixed(1),
  delay: (-rand() * 18).toFixed(1),
  drift: ((rand() - 0.5) * 80).toFixed(0),
}));
---
<div class:list={['spores', className]} aria-hidden="true">
  {spores.map((s) => (
    <span style={`left:${s.left}%; bottom:${s.bottom}%; width:${s.size}px; height:${s.size}px; --dur:${s.duration}s; --delay:${s.delay}s; --drift:${s.drift}px`} />
  ))}
</div>

<style>
  .spores { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  span {
    position: absolute; border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--cap-tan) 90%, #fff), transparent 70%);
    opacity: 0; animation: float var(--dur) linear var(--delay) infinite;
  }
  @keyframes float {
    0% { transform: translate(0, 0); opacity: 0; }
    15% { opacity: .85; }
    85% { opacity: .5; }
    100% { transform: translate(var(--drift), -220px); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    span { animation: none; opacity: .4; }
  }
</style>
