---
// Hand-drawn style mushroom illustrations. Decorative only.
interface Props {
  variant?: 'amanita' | 'parasol' | 'button' | 'chanterelle' | 'sprout';
  size?: number;
  class?: string;
  style?: string;
  [attr: string]: unknown;
}
const { variant = 'amanita', size = 64, class: className, style, ...rest } = Astro.props;
---
<svg
  class:list={['mushroom', className]}
  style={style}
  width={size}
  height={Math.round((size * 61) / 64)}
  viewBox="0 0 64 61"
  aria-hidden="true"
  focusable="false"
  {...rest}
>
  {variant === 'amanita' && (
    <g>
      <path d="M26 34 Q24.5 50 22.5 60 H41.5 Q39.5 50 38 34 Z" fill="var(--stem)" stroke="var(--ink)" stroke-width="1.5" stroke-linejoin="round" />
      <path d="M25.5 44 Q32 47 38.5 44" fill="none" stroke="var(--ink)" stroke-width="1.2" stroke-linecap="round" />
      <path d="M6 36 Q6 9 32 9 Q58 9 58 36 Q32 41 6 36 Z" fill="var(--cap-red)" stroke="var(--ink)" stroke-width="1.5" stroke-linejoin="round" />
      <circle cx="20" cy="22" r="3.2" fill="var(--stem)" />
      <circle cx="33" cy="16" r="2.4" fill="var(--stem)" />
      <circle cx="44" cy="24" r="3.6" fill="var(--stem)" />
      <circle cx="29" cy="29" r="2" fill="var(--stem)" />
      <circle cx="13" cy="31" r="1.6" fill="var(--stem)" />
      <circle cx="51" cy="32" r="1.8" fill="var(--stem)" />
    </g>
  )}
  {variant === 'parasol' && (
    <g>
      <path d="M30 27 L28.5 60 H35.5 L34 27 Z" fill="var(--stem)" stroke="var(--ink)" stroke-width="1.5" stroke-linejoin="round" />
      <path d="M27.5 36 H36.5" stroke="var(--ink)" stroke-width="1.4" stroke-linecap="round" />
      <path d="M6 29 Q18 8 32 7 Q46 8 58 29 Q32 33 6 29 Z" fill="var(--cap-brown)" stroke="var(--ink)" stroke-width="1.5" stroke-linejoin="round" />
      <path d="M28 10 Q32 6 36 10 Q32 12 28 10 Z" fill="var(--ink)" opacity=".55" />
      <path d="M17 21 l3 -1 M44 21 l3 1 M24 15 l2 -1 M38 15 l2 1 M31 23 h2" stroke="var(--stem)" stroke-width="1.6" stroke-linecap="round" />
    </g>
  )}
  {variant === 'button' && (
    <g>
      <path d="M25 42 Q24 53 23 60 H39 Q38 53 37 42 Z" fill="var(--stem)" stroke="var(--ink)" stroke-width="1.5" stroke-linejoin="round" />
      <path d="M13 44 Q13 20 31 20 Q49 20 49 44 Q31 47 13 44 Z" fill="var(--cap-tan)" stroke="var(--ink)" stroke-width="1.5" stroke-linejoin="round" />
      <path d="M20 30 Q24 25 30 24" fill="none" stroke="var(--stem)" stroke-width="2" stroke-linecap="round" opacity=".8" />
    </g>
  )}
  {variant === 'chanterelle' && (
    <g>
      <path d="M8 22 Q13 16 20 20 Q26 14 32 19 Q38 14 44 20 Q51 16 56 22 Q50 30 40 37 Q36.5 46 36.5 60 H27.5 Q27.5 46 24 37 Q14 30 8 22 Z" fill="#e9a23b" stroke="var(--ink)" stroke-width="1.5" stroke-linejoin="round" />
      <path d="M12 22.5 Q32 30 52 22.5" fill="none" stroke="var(--ink)" stroke-width="1.2" stroke-linecap="round" opacity=".6" />
      <path d="M18 27 Q24 33 27 40 M25 28.5 Q28 34 29.5 42 M32 29 V44 M39 28.5 Q36 34 34.5 42 M46 27 Q40 33 37 40" fill="none" stroke="var(--ink)" stroke-width="1" opacity=".4" stroke-linecap="round" />
    </g>
  )}
  {variant === 'sprout' && (
    <g>
      <path d="M29.5 44 Q29 53 28.5 60 H35.5 Q35 53 34.5 44 Z" fill="var(--stem)" stroke="var(--ink)" stroke-width="1.5" stroke-linejoin="round" />
      <path d="M22 46 Q22 31 32 31 Q42 31 42 46 Q32 48.5 22 46 Z" fill="var(--cap-red)" stroke="var(--ink)" stroke-width="1.5" stroke-linejoin="round" />
      <circle cx="28" cy="38" r="1.8" fill="var(--stem)" />
      <circle cx="35.5" cy="36" r="1.3" fill="var(--stem)" />
    </g>
  )}
</svg>

<style>
  .mushroom { display: block; overflow: visible; transform-origin: 50% 100%; }
</style>
