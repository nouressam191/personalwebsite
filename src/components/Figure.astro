---
// Shows the image if `src` is set, otherwise a labelled placeholder so the
// layout still works while images are being added.
interface Props {
  src?: string;
  alt: string;
  ratio?: string;
  caption?: string;
  position?: string;
  /** Show the whole image inside the frame (no crop, no parallax zoom). */
  natural?: boolean;
}
const { src, alt, ratio = '4 / 3', caption, position = 'center', natural = false } = Astro.props;
---
<figure style={`--ratio: ${ratio}; --pos: ${position}`}>
  {src
    ? <div class:list={['frame', { natural }]}><img src={src} alt={alt} loading="lazy" decoding="async" /></div>
    : <div class="ph" role="img" aria-label={alt}><span>{alt}</span></div>}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  figure { margin: 0; }
  .frame { overflow: hidden; border-radius: var(--radius); aspect-ratio: var(--ratio); }
  .frame img { width: 100%; height: 100%; scale: 1.1; object-fit: cover; object-position: var(--pos); transition: scale .6s ease; }
  .frame.natural img { object-fit: contain; scale: 1; }
  .ph { width: 100%; aspect-ratio: var(--ratio); border-radius: var(--radius); }
  @media (prefers-reduced-motion: reduce) { .frame img { scale: 1; } }
  .ph {
    display: grid; place-items: center; padding: 16px; text-align: center;
    background:
      radial-gradient(circle at 30% 20%, var(--accent-soft), transparent 60%),
      var(--surface-2);
    border: 1px dashed var(--line); color: var(--muted); font-size: 0.85rem;
  }
  figcaption { margin-top: 10px; font-family: var(--serif); font-size: 1.1rem; }
</style>
