---
import Layout from '../layouts/Layout.astro';
import Figure from '../components/Figure.astro';
import { shemsiProjects, shemsiSocial } from '../data/work';
---
<Layout title="Shemsi MENA" description="Case study: how Nour Essam grew Shemsi period underwear across MENA through brand, content, influencers, events and performance marketing.">
  <header class="page-head wrap">
    <span class="eyebrow">Case study · Brand Manager</span>
    <h1>Shemsi: building a period-care brand across MENA</h1>
    <p class="lede">
      As Growth & Marketing Manager at OneCommerce I led Shemsi period underwear in Egypt, the UAE, KSA, Kuwait, Morocco and Lebanon, growing sales 11× in a year.
    </p>
    <div class="btn-row">
      <a class="btn primary" href="/successful-marketing-campaigns">Campaigns</a>
      <a class="btn ghost" href="/photoshoot-highlights">Photoshoot</a>
    </div>
  </header>

  <div class="wrap hero-shot">
    <Figure src="/images/shemsi/photoshoot.jpg" alt="Shemsi product photoshoot with four models" ratio="21 / 9" position="50% 35%" />
  </div>

  <section class="section wrap">
    <div class="grid three">
      {shemsiProjects.map((p) => (
        <article class="card proj">
          <Figure src={p.image} alt={p.title} ratio="3 / 2" />
          <h3>{p.title}</h3>
          <p>{p.text}</p>
          {p.link && (
            <a class="link" href={p.link.href} target={p.link.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
              {p.link.label} →
            </a>
          )}
        </article>
      ))}
    </div>
  </section>

  <section class="section tint">
    <div class="wrap">
      <div class="social-head">
        <div>
          <span class="eyebrow">Social media growth</span>
          <h2>Communities I grew</h2>
          <p class="lede">I grew Shemsi's audience across four platforms, passing 100K followers on Instagram alone.</p>
        </div>
        <img class="ig" src="/images/shemsi/instagram.jpg" alt="Shemsi Instagram profile with 101K followers" loading="lazy" decoding="async" />
      </div>
      <div class="grid four">
        {shemsiSocial.map((s) => (
          <a class="card" href={s.href} target="_blank" rel="noopener">
            <span class="muted">{s.platform}</span>
            <strong class="stat">{s.stat}</strong>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-head .lede { margin-bottom: 28px; }
  .proj { padding: 14px 14px 24px; }
  .proj > :not(figure) { margin-inline: 10px; }
  .proj :global(figure) { margin-bottom: 18px; }
  .hero-shot { margin-bottom: 8px; }
  .social-head { display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; align-items: center; margin-bottom: 32px; }
  .ig { width: 100%; border-radius: var(--radius); box-shadow: 0 18px 40px rgba(31, 26, 23, .15); }
  @media (max-width: 760px) { .social-head { grid-template-columns: 1fr; } }
  .stat { font-family: var(--serif); font-weight: 500; font-size: 1.5rem; line-height: 1.2; margin-top: 6px; }
</style>
