---
import Layout from '../layouts/Layout.astro';
import Figure from '../components/Figure.astro';
import ContactLinks from '../components/ContactLinks.astro';
import Mushroom from '../components/Mushroom.astro';
import MushroomPatch from '../components/MushroomPatch.astro';
import Mycelium from '../components/Mycelium.astro';
import Spores from '../components/Spores.astro';
import WhyMushrooms from '../components/WhyMushrooms.astro';
import ToptalBadge from '../components/ToptalBadge.astro';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/600.css';
import { services, organizations, contact, roles, oxtongrid, bookingHref } from '../data/site';
import { experience } from '../data/cv';

const toptalWork = experience.filter((r) => r.via === 'Toptal');
const cardMushrooms = ['amanita', 'parasol', 'chanterelle', 'button'] as const;

// "How I grow brands": a mushroom's life cycle as a working process.
const lifecycle = [
  { stage: 'Spore', step: 'Strategy', text: 'Every brand starts small. I dig into the market, the audience and the numbers to find the idea worth planting.' },
  { stage: 'Mycelium', step: 'Foundations', text: 'Before anything shows above ground, I build the network underneath: positioning, brand, website, content and the systems that connect them.' },
  { stage: 'Sprout', step: 'Launch', text: 'Then it breaks through. Campaigns, launches, partnerships and PR that get the brand seen in the right places.' },
  { stage: 'Mushroom', step: 'Growth', text: 'Finally it flourishes. I measure, optimise and scale what works, so growth keeps coming season after season.' },
];
---
<Layout footerCta={false}>
  <div class="hero-shell">
  <Mycelium class="hero-mycelium" animate="load" seed={11} roots={9} />
  <Spores count={22} seed={5} />
  <section class="hero wrap">
    <div class="hero-text">
      <span class="eyebrow enter" style="--d:.05s">Hi there, welcome to my world</span>
      <a class="talent-pill enter" style="--d:.15s" href="#top-talent">
        <span aria-hidden="true">★</span> Top 3% marketing talent worldwide · vetted by Toptal
      </a>
      <h1 class="rise">
        <span style="--w:0">Full-stack</span>
        <span style="--w:1">marketing</span>
        <span style="--w:2">expert.</span>
      </h1>
      <ul class="roles enter" style="--d:.75s" aria-label="What I do">
        {roles.map((r) => <li>{r}</li>)}
      </ul>
      <p class="lede enter" style="--d:.9s">
        I'm Nour, a marketer and growth expert working across MENA and the US. In my spare time I'm also an artist and a home cook.
      </p>
      <div class="btn-row enter" style="--d:1.05s">
        <a class="btn primary" href={bookingHref} target="_blank" rel="noopener">Book a call</a>
        <a class="btn ghost" href="/portfolio">See my work</a>
        <a class="btn ghost" href="/about-me">Get to know me</a>
      </div>
    </div>
    <div class="portrait enter" style="--d:.3s">
      <Figure src="/images/about/portrait-mountains.jpg" alt="Nour Essam smiling on a balcony with mountains behind her" ratio="4 / 5" position="center" />
      <Mushroom variant="amanita" size={104} class="m m1" data-burst />
      <Mushroom variant="button" size={50} class="m m2" data-burst />
      <Mushroom variant="parasol" size={80} class="m m3" data-burst />
      <Mushroom variant="chanterelle" size={44} class="m m4" data-burst />
      <span class="ground" aria-hidden="true"></span>
      <p class="hint" aria-hidden="true">psst… tap a mushroom</p>
    </div>
  </section>
  </div>

  <section class="logos-band" aria-label="Companies and organizations I've worked with">
    <div class="wrap">
      <span class="eyebrow">Companies & organizations I've worked with</span>
    </div>
    <div class="marquee">
      <div class="marquee-track">
        {[0, 1].map((copy) => (
          <ul class="logos" aria-hidden={copy === 1 ? 'true' : undefined}>
            {organizations.map((o) => (
              <li>
                {o.logo && <img class:list={{ tall: o.tall }} src={o.logo} alt={copy === 0 && !o.showName ? o.name : ''} loading="lazy" decoding="async" />}
                {(!o.logo || o.showName) && <span class="wordmark">{o.name}</span>}
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </section>

  <section class="section og-section" id="oxtongrid">
    <div class="wrap og" data-reveal>
      <div>
        <span class="og-eyebrow">My company</span>
        <h2 class="og-logo"><img src="/images/logos/oxtongrid.png" alt="OxtonGrid" width="1000" height="171" /></h2>
        <p class="og-tagline">We don't just do digital transformation, <span>we make it make sense.</span></p>
        <p class="og-text">
          I co-founded OxtonGrid, a UAE-based digital transformation partner, and lead it as CMO. We help SMEs and
          mid-market businesses choose, implement and get real value from the right tools, with zero nonsense: no
          unnecessary software, no hidden costs and no overbuilt systems.
        </p>
        <a class="og-btn" href={contact.oxtongrid} target="_blank" rel="noopener">Visit oxtongrid.com <span aria-hidden="true">→</span></a>
      </div>
      <div class="og-panel">
        <span class="og-label">What we do</span>
        <ul>
          {oxtongrid.services.map((s) => (
            <li>
              <strong>{s.title}</strong>
              <span>{s.tools}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section" id="top-talent">
    <div class="wrap talent" data-reveal>
      <div class="talent-badge"><ToptalBadge /></div>
      <div>
        <span class="eyebrow">Recognition</span>
        <h2>Among the top 3% of marketing talent in the world</h2>
        <p class="lede">
          Toptal, the global network of elite freelance talent, accepts only the top 3% of the professionals who apply.
          I passed its rigorous screening of expertise, communication and real-world project work, and I'm now one of
          its vetted marketing experts.
        </p>
        <p class="muted">Through Toptal I partner with companies across MENA and the US, including:</p>
        <ul class="engagements">
          {toptalWork.map((r) => (
            <li>
              <strong>{r.company}</strong>
              <span>{r.title} · {r.period}</span>
            </li>
          ))}
        </ul>
        <div class="btn-row">
          <a class="btn primary" href={contact.toptal} target="_blank" rel="noopener">Hire me on Toptal</a>
          <a class="btn ghost" href="/cv">View my CV</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section tint">
    <div class="wrap">
      <div data-reveal>
        <span class="eyebrow">How I can help you</span>
        <h2>Four ways to work together</h2>
      </div>
      <div class="grid four services">
        {services.map((s, i) => (
          <a class="card service" data-reveal style={`--d:${i * 0.1}s`} href={s.href} target={s.href.startsWith('http') ? '_blank' : undefined} rel={s.href.startsWith('http') ? 'noopener' : undefined}>
            <span class="num">0{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <span class="link">{s.cta} →</span>
            <Mushroom variant={cardMushrooms[i % cardMushrooms.length]} size={46} class="peek" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="forest" data-reveal>
    <Mycelium class="forest-mycelium" seed={23} roots={8} />
    <Spores count={26} seed={9} />
    <div class="wrap forest-inner">
      <div class="forest-head">
        <span class="eyebrow">From spore to mushroom</span>
        <h2>How I grow brands</h2>
        <p class="lede">Mushrooms grow from an invisible network underground before they ever break the surface. Brands do too.</p>
      </div>
      <ol class="cycle">
        {lifecycle.map((l, i) => (
          <li style={`--d:${0.3 + i * 0.25}s`}>
            <div class="cycle-art" aria-hidden="true">
              {i === 0 && (
                <svg viewBox="0 0 64 61" width="64" height="61"><circle cx="32" cy="40" r="5" fill="var(--cap-tan)" /><circle cx="32" cy="40" r="11" fill="none" stroke="var(--cap-tan)" stroke-opacity=".45" /><circle cx="32" cy="40" r="18" fill="none" stroke="var(--cap-tan)" stroke-opacity=".2" /></svg>
              )}
              {i === 1 && (
                <svg viewBox="0 0 64 61" width="64" height="61" fill="none" stroke="var(--cap-tan)" stroke-width="1.6" stroke-linecap="round"><path d="M32 58 Q30 46 33 36 Q36 26 30 16" /><path d="M32 46 Q22 42 16 30" /><path d="M33 38 Q44 34 50 24" /><path d="M21 37 Q14 38 9 34" /><path d="M44 31 Q50 34 56 32" /><circle cx="30" cy="16" r="2" fill="var(--cap-tan)" /><circle cx="16" cy="30" r="2" fill="var(--cap-tan)" /><circle cx="50" cy="24" r="2" fill="var(--cap-tan)" /></svg>
              )}
              {i === 2 && <Mushroom variant="sprout" size={64} />}
              {i === 3 && <Mushroom variant="amanita" size={64} />}
            </div>
            <span class="cycle-stage">{String(i + 1).padStart(2, '0')} · {l.stage}</span>
            <h3>{l.step}</h3>
            <p>{l.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div data-reveal>
        <span class="eyebrow">Beyond marketing</span>
        <h2>The other sides of me</h2>
      </div>
      <div class="grid two" data-reveal style="--d:.15s">
        <a class="card side" href="/art-projects">
          <Mushroom variant="amanita" size={56} class="corner" data-burst />
          <h3>Art</h3>
          <p>Paintings and portraits. Landscapes, dreamers and a little Ghibli.</p>
          <span class="link">View the gallery →</span>
        </a>
        <a class="card side" href="/cooking">
          <Mushroom variant="chanterelle" size={56} class="corner" data-burst />
          <h3>Nourish Diary</h3>
          <p>Nourishing recipes inspired by cuisines from around the world.</p>
          <span class="link">Into the kitchen →</span>
        </a>
      </div>
    </div>
  </section>

  <div class="wrap"><MushroomPatch align="right" class="divider" /></div>

  <WhyMushrooms class="tint" />

  <section class="section cta-section">
    <Spores count={16} seed={17} />
    <div class="wrap cta" data-reveal>
      <div class="cta-text">
        <span class="eyebrow">Let's plant something</span>
        <h2>Have a brand to grow?</h2>
        <p class="lede">Book a call, get in touch on whichever channel suits you, or <a class="link" href={contact.toptal} target="_blank" rel="noopener">hire me through Toptal</a>.</p>
        <div class="cta-actions">
          <a class="btn primary" href={bookingHref} target="_blank" rel="noopener">Book a call</a>
          <ContactLinks />
        </div>
      </div>
      <div class="cta-grove" aria-hidden="true" data-grow>
        <Mushroom variant="parasol" size={110} data-burst />
        <Mushroom variant="amanita" size={150} data-burst />
        <Mushroom variant="sprout" size={64} data-burst />
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(32px, 6vw, 80px);
    align-items: center; padding-top: clamp(48px, 8vw, 96px); padding-bottom: clamp(48px, 8vw, 96px);
  }
  .hero h1 { font-size: clamp(2.4rem, 5vw, 3.8rem); max-width: 14ch; }
  .hero h1 em { font-style: italic; color: var(--accent); }
  .roles { list-style: none; padding: 0; margin: 4px 0 26px; display: flex; flex-wrap: wrap; gap: 8px; max-width: 560px; }
  .roles li {
    display: inline-flex; align-items: center; gap: 7px; padding: 6px 12px;
    background: var(--surface); border: 1px solid var(--line); border-radius: 999px;
    font-size: 0.85rem; font-weight: 500; color: var(--ink);
  }
  .roles li::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  .hero .lede { margin-bottom: 32px; }
  .talent-pill {
    display: inline-flex; align-items: center; gap: 8px; margin: 0 0 22px;
    padding: 7px 14px; border-radius: 999px; text-decoration: none;
    background: #eaf1ff; color: #204ecf; border: 1px solid #c9dafc;
    font-size: 0.85rem; font-weight: 600; transition: background .2s, border-color .2s;
  }
  .talent-pill:hover { background: #dde8ff; border-color: #25a9ef; }
  .talent-pill span { color: #25a9ef; }

  /* OxtonGrid brand: colours and type from oxtongrid.com */
  .og-section {
    --og-green: #2fb663; --og-navy: #001a33; --og-mint: #85dfa8;
    background: #fff; color: var(--og-navy);
    font-family: 'Poppins', var(--sans);
    border-top: 1px solid #e3ece6; border-bottom: 1px solid #e3ece6;
  }
  .og { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  .og-eyebrow {
    display: inline-block; margin-bottom: 18px; padding: 5px 12px; border-radius: 6px;
    background: #eaf8f0; color: #1f8a49; font-size: 0.75rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase;
  }
  .og-logo { margin: 0 0 22px; }
  .og-logo img { width: min(100%, 340px); height: auto; }
  .og-tagline { font-weight: 600; font-size: clamp(1.25rem, 2.1vw, 1.55rem); line-height: 1.35; margin-bottom: 18px; letter-spacing: -0.01em; }
  .og-tagline span { color: var(--og-green); }
  .og-text { color: #4a5a6a; font-size: 1.02rem; line-height: 1.7; margin-bottom: 30px; max-width: 58ch; }
  .og-btn {
    display: inline-flex; align-items: center; gap: 10px; padding: 13px 24px; border-radius: 8px;
    background: var(--og-green); color: var(--og-navy); text-decoration: none;
    font-weight: 600; font-size: 0.98rem; transition: background .2s, transform .2s, box-shadow .2s;
  }
  .og-btn:hover { background: #29a259; transform: translateY(-1px); box-shadow: 0 8px 20px rgba(47, 182, 99, .3); }
  .og-btn:focus-visible { outline: 2px solid var(--og-navy); outline-offset: 3px; }
  .og-panel {
    padding: 28px; border-radius: 16px; color: #fff;
    background-color: var(--og-navy);
    background-image:
      linear-gradient(rgba(47, 182, 99, .14) 1px, transparent 1px),
      linear-gradient(90deg, rgba(47, 182, 99, .14) 1px, transparent 1px);
    background-size: 28px 28px;
    box-shadow: 0 24px 48px rgba(0, 26, 51, .18);
  }
  .og-label { display: block; font-size: 0.75rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--og-mint); margin-bottom: 14px; }
  .og-panel ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .og-panel li {
    display: flex; flex-direction: column; padding: 14px 16px; border-radius: 10px;
    background: rgba(0, 26, 51, .72); border: 1px solid rgba(133, 223, 168, .18); border-left: 3px solid var(--og-green);
  }
  .og-panel strong { font-weight: 600; font-size: 1.02rem; }
  .og-panel li span { font-size: 0.85rem; color: var(--og-mint); opacity: .85; }
  @media (max-width: 820px) { .og { grid-template-columns: 1fr; } }

  .talent { display: grid; grid-template-columns: auto 1fr; gap: clamp(40px, 7vw, 96px); align-items: center; }
  .talent-badge { transform: scale(1.2); transform-origin: center; padding: 24px; }
  .talent .lede { margin-bottom: 20px; }
  .engagements {
    list-style: none; padding: 0; margin: 0 0 32px;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr)); gap: 12px;
  }
  .engagements li {
    display: flex; flex-direction: column; padding: 14px 16px;
    background: var(--surface); border: 1px solid var(--line); border-left: 3px solid #25a9ef; border-radius: 10px;
  }
  .engagements strong { font-family: var(--serif); font-weight: 500; font-size: 1.1rem; }
  .engagements span { color: var(--muted); font-size: 0.88rem; }
  @media (max-width: 820px) {
    .talent { grid-template-columns: 1fr; }
    .talent-badge { transform: none; padding: 0; justify-self: center; }
  }
  @media (max-width: 820px) { .hero { grid-template-columns: 1fr; } .portrait { max-width: 420px; } }

  .portrait { position: relative; margin-bottom: 56px; }
  .portrait :global(.m) { position: absolute; bottom: -22px; z-index: 2; }
  .portrait :global(.m1) { left: -34px; }
  .portrait :global(.m2) { left: 52px; }
  .portrait :global(.m3) { right: -26px; }
  .portrait :global(.m4) { right: 50px; }
  .ground {
    position: absolute; left: -48px; right: -40px; bottom: -23px; height: 3px; border-radius: 3px;
    background: linear-gradient(90deg, transparent, var(--moss) 12%, var(--moss) 88%, transparent);
  }
  .hint {
    position: absolute; left: 0; right: 0; bottom: -54px; margin: 0; text-align: center;
    font: italic 500 .9rem var(--serif); color: var(--muted); transition: opacity .6s;
  }
  :global(.burst-used) .hint { opacity: 0; }
  .portrait :global(.m1) { animation: sway 6s ease-in-out infinite; }
  .portrait :global(.m3) { animation: sway 7s ease-in-out -2s infinite reverse; }
  @keyframes sway { 0%, 100% { transform: rotate(-3deg); } 50% { transform: rotate(3deg); } }
  @media (prefers-reduced-motion: reduce) { .portrait :global(.m) { animation: none !important; } }
  @media (max-width: 520px) { .portrait :global(.m1) { left: -8px; } .portrait :global(.m3) { right: -6px; } }

  .side { position: relative; padding-right: 88px; }
  .side :global(.corner) { position: absolute; top: 20px; right: 20px; transition: transform .4s cubic-bezier(.3, 1.6, .5, 1); }
  .side:hover :global(.corner) { transform: rotate(-8deg) scale(1.08); }
  .divider { margin-top: clamp(8px, 2vw, 24px); }


  .services { margin-top: 32px; }
  .num { font-family: var(--serif); color: var(--accent); font-size: 1.1rem; margin-bottom: 18px; }

  .logos-band { padding: 8px 0 clamp(48px, 7vw, 80px); }
  .marquee {
    overflow: hidden; margin-top: 12px; padding-block: 8px;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee-track { display: flex; width: max-content; animation: marquee 40s linear infinite; }
  .marquee:hover .marquee-track { animation-play-state: paused; }
  @keyframes marquee { to { transform: translateX(-50%); } }
  .logos { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; }
  .logos li {
    display: flex; align-items: center; gap: 10px; flex: none;
    height: 88px; padding: 0 22px; margin-right: 16px;
    background: var(--surface); border: 1px solid var(--line); border-radius: 14px;
  }
  .logos img { height: 40px; width: auto; max-width: 170px; object-fit: contain; }
  .logos img.tall { height: 68px; }
  .wordmark { font-family: var(--serif); font-size: 1.4rem; font-weight: 500; color: var(--ink); white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) {
    .marquee { -webkit-mask-image: none; mask-image: none; }
    .marquee-track { animation: none; width: auto; padding-inline: var(--gutter); }
    .logos { flex-wrap: wrap; gap: 12px; }
    .logos[aria-hidden] { display: none; }
    .logos li { margin-right: 0; }
  }

  .cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 40px; }
  .cta-text { flex: 1 1 380px; }
  /* Hero: mycelium, spores and entrance */
  .hero-shell { position: relative; overflow: hidden; }
  .hero-shell > :global(.hero-mycelium) {
    position: absolute; left: 0; right: 0; bottom: 0; height: 40%; opacity: .3; pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 35%, #000 60%, transparent), linear-gradient(90deg, rgba(0,0,0,.2), #000 55%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to bottom, transparent, #000 35%, #000 60%, transparent), linear-gradient(90deg, rgba(0,0,0,.2), #000 55%);
    mask-composite: intersect;
  }
  .hero { position: relative; z-index: 1; }
  .rise > span { display: inline-block; }
  .rise > span:not(:last-child) { margin-right: .26em; }
  :global(.js) .rise > span { opacity: 0; animation: rise .9s cubic-bezier(.2, .7, .2, 1) calc(.2s + var(--w) * .12s) forwards; }
  :global(.js) .enter { opacity: 0; animation: fadeup .8s cubic-bezier(.2, .7, .2, 1) var(--d, 0s) forwards; }
  :global(.js) .portrait :global(.m) { scale: 1 0; animation: sprout .9s cubic-bezier(.3, 1.5, .5, 1) 1s forwards; }
  :global(.js) .portrait :global(.m1) { animation: sprout .9s cubic-bezier(.3, 1.5, .5, 1) .8s forwards, sway 6s ease-in-out 1.7s infinite; }
  :global(.js) .portrait :global(.m2) { animation-delay: 1.15s; }
  :global(.js) .portrait :global(.m3) { animation: sprout .9s cubic-bezier(.3, 1.5, .5, 1) 1.05s forwards, sway 7s ease-in-out 2s infinite reverse; }
  :global(.js) .portrait :global(.m4) { animation-delay: 1.3s; }
  @keyframes rise { from { opacity: 0; transform: translateY(.55em) rotate(2deg); } to { opacity: 1; transform: none; } }
  @keyframes fadeup { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes sprout { to { scale: 1 1; } }

  /* Service cards: a mushroom peeks up on hover */
  .service { position: relative; overflow: hidden; }
  .service :global(.peek) { position: absolute; right: 16px; bottom: -2px; translate: 0 110%; transition: translate .45s cubic-bezier(.3, 1.6, .5, 1); }
  .service:hover :global(.peek), .service:focus-visible :global(.peek) { translate: 0 0; }

  /* "How I grow brands": underground forest section */
  .forest { position: relative; overflow: hidden; background: #1f2f28; color: #f3ede6; padding: clamp(72px, 10vw, 128px) 0; }
  .forest > :global(.forest-mycelium) { position: absolute; left: 0; right: 0; bottom: 0; height: 55%; opacity: .26; }
  .forest-inner { position: relative; z-index: 1; }
  .forest-head { max-width: 640px; margin-bottom: clamp(36px, 5vw, 56px); }
  .forest .eyebrow { color: var(--cap-tan); }
  .forest h2 { color: #fff; }
  .forest .lede { color: rgba(243, 237, 230, .75); }
  .cycle { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; position: relative; }
  .cycle::before {
    content: ''; position: absolute; left: 32px; right: 32px; top: 61px; height: 2px;
    background: linear-gradient(90deg, var(--cap-tan), var(--moss), var(--cap-red));
